<!-- 1. Upload Files Modal -->
<div class="modal fade" id="uploadModal" tabindex="-1" aria-labelledby="uploadModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content border-0 shadow">
      <div class="modal-header border-bottom">
        <h5 class="modal-title fw-bold text-dark" id="uploadModalLabel">
          <i class="fa-solid fa-cloud-arrow-up text-primary me-2"></i>Upload Files to AWS S3
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <!-- Destination Folder Selector -->
        <div class="mb-3">
          <label for="uploadDestinationFolder" class="form-label small fw-semibold text-muted">Destination Folder:</label>
          <select class="form-select" id="uploadDestinationFolder">
            <option value="null" selected>📁 Root Directory (My Files)</option>
            <% if (typeof allUserFolders !== 'undefined' && allUserFolders.length > 0) { %>
              <% allUserFolders.forEach(function(f) { %>
                <option value="<%= f._id %>" <%= typeof currentFolder !== 'undefined' && currentFolder && currentFolder._id.toString() === f._id.toString() ? 'selected' : '' %>>
                  📁 <%= f.folderName %>
                </option>
              <% }); %>
            <% } %>
          </select>
        </div>

        <!-- Drag & Drop Zone -->
        <div id="dropZone" class="drop-zone border-2 border-dashed rounded-4 p-4 text-center mb-3 bg-light transition-all">
          <div class="py-4">
            <div class="drop-zone-icon mb-3">
              <i class="fa-solid fa-cloud-arrow-up fs-1 text-primary"></i>
            </div>
            <h6 class="fw-bold mb-1">Drag and drop your files here</h6>
            <p class="text-muted small mb-3">or click to browse from your device</p>
            <input type="file" id="fileInput" multiple class="d-none">
            <button type="button" class="btn btn-outline-primary px-4 rounded-pill" onclick="document.getElementById('fileInput').click()">
              <i class="fa-solid fa-folder-open me-2"></i>Browse Files
            </button>
            <div class="mt-3 text-muted" style="font-size: 0.78rem;">
              Maximum file size: <strong>50 MB</strong> per file. Images, Documents, PDFs, Media, Archives supported.
            </div>
          </div>
        </div>

        <!-- Selected Files List -->
        <div id="selectedFilesContainer" class="d-none">
          <h6 class="small fw-bold text-dark mb-2">Files to upload (<span id="fileCountBadge">0</span>):</h6>
          <div id="selectedFilesList" class="overflow-auto border rounded-3 p-2 bg-white mb-3" style="max-height: 160px;">
            <!-- Rendered by JS -->
          </div>
        </div>

        <!-- Upload Progress Indicator -->
        <div id="uploadProgressContainer" class="d-none mb-3">
          <div class="d-flex justify-content-between small fw-medium mb-1">
            <span id="uploadProgressStatus">Uploading to AWS S3...</span>
            <span id="uploadProgressPercentage">0%</span>
          </div>
          <div class="progress" style="height: 10px;">
            <div id="uploadProgressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 0%"></div>
          </div>
        </div>
      </div>
      <div class="modal-footer border-top bg-light">
        <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="startUploadBtn" class="btn btn-primary rounded-pill px-4" disabled>
          <i class="fa-solid fa-upload me-2"></i>Start Upload
        </button>
      </div>
    </div>
  </div>
</div>

<!-- 2. New Folder Modal -->
<div class="modal fade" id="newFolderModal" tabindex="-1" aria-labelledby="newFolderModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <form action="/api/folders" method="POST" id="newFolderForm">
        <div class="modal-header border-bottom">
          <h5 class="modal-title fw-bold text-dark" id="newFolderModalLabel">
            <i class="fa-solid fa-folder-plus text-warning me-2"></i>Create New Folder
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <input type="hidden" name="parentFolderId" value="<%= typeof currentFolder !== 'undefined' && currentFolder ? currentFolder._id : 'null' %>">
          
          <div class="mb-3">
            <label for="folderNameInput" class="form-label small fw-semibold text-muted">Folder Name</label>
            <input type="text" class="form-control form-control-lg" id="folderNameInput" name="folderName" placeholder="e.g. Invoices, Projects, Photos" required autofocus>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold text-muted d-block">Folder Color Theme</label>
            <div class="d-flex gap-2">
              <label class="color-radio">
                <input type="radio" name="color" value="#4f46e5" checked>
                <span class="color-badge" style="background-color: #4f46e5;"></span>
              </label>
              <label class="color-radio">
                <input type="radio" name="color" value="#0284c7">
                <span class="color-badge" style="background-color: #0284c7;"></span>
              </label>
              <label class="color-radio">
                <input type="radio" name="color" value="#10b981">
                <span class="color-badge" style="background-color: #10b981;"></span>
              </label>
              <label class="color-radio">
                <input type="radio" name="color" value="#f59e0b">
                <span class="color-badge" style="background-color: #f59e0b;"></span>
              </label>
              <label class="color-radio">
                <input type="radio" name="color" value="#ef4444">
                <span class="color-badge" style="background-color: #ef4444;"></span>
              </label>
              <label class="color-radio">
                <input type="radio" name="color" value="#8b5cf6">
                <span class="color-badge" style="background-color: #8b5cf6;"></span>
              </label>
            </div>
          </div>
        </div>
        <div class="modal-footer border-top bg-light">
          <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary rounded-pill px-4">
            <i class="fa-solid fa-check me-2"></i>Create Folder
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- 3. Rename Modal -->
<div class="modal fade" id="renameModal" tabindex="-1" aria-labelledby="renameModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <form id="renameForm" method="POST">
        <div class="modal-header border-bottom">
          <h5 class="modal-title fw-bold text-dark" id="renameModalLabel">
            <i class="fa-solid fa-pen text-primary me-2"></i>Rename
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <div class="mb-3">
            <label for="renameInput" class="form-label small fw-semibold text-muted">New Name</label>
            <input type="text" class="form-control form-control-lg" id="renameInput" name="newName" required>
          </div>
        </div>
        <div class="modal-footer border-top bg-light">
          <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary rounded-pill px-4">Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- 4. Move File Modal -->
<div class="modal fade" id="moveModal" tabindex="-1" aria-labelledby="moveModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <form id="moveForm" method="POST">
        <div class="modal-header border-bottom">
          <h5 class="modal-title fw-bold text-dark" id="moveModalLabel">
            <i class="fa-solid fa-folder-tree text-info me-2"></i>Move to Folder
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <p class="small text-muted mb-3">Select the destination folder for <strong id="moveFileName" class="text-dark">this item</strong>:</p>
          <div class="mb-3">
            <select class="form-select form-select-lg" name="targetFolderId" id="moveTargetFolder">
              <option value="root">📁 Root Directory (My Files)</option>
              <% if (typeof allUserFolders !== 'undefined' && allUserFolders.length > 0) { %>
                <% allUserFolders.forEach(function(f) { %>
                  <option value="<%= f._id %>">📁 <%= f.folderName %></option>
                <% }); %>
              <% } %>
            </select>
          </div>
        </div>
        <div class="modal-footer border-top bg-light">
          <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary rounded-pill px-4">Move Here</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- 5. Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <form id="deleteConfirmForm" method="POST">
        <div class="modal-header border-bottom">
          <h5 class="modal-title fw-bold text-danger" id="deleteModalLabel">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>Confirm Deletion
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <p id="deleteMessage" class="text-dark mb-2">Are you sure you want to delete this item?</p>
          <p id="deleteSubMessage" class="small text-muted mb-0">This item will be moved to the Trash and can be restored later.</p>
        </div>
        <div class="modal-footer border-top bg-light">
          <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" id="deleteSubmitBtn" class="btn btn-danger rounded-pill px-4">
            <i class="fa-solid fa-trash me-2"></i>Delete
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- 6. File Preview Modal (Images and PDFs) -->
<div class="modal fade" id="previewModal" tabindex="-1" aria-labelledby="previewModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-xl">
    <div class="modal-content border-0 shadow">
      <div class="modal-header border-bottom bg-white py-2">
        <div class="d-flex align-items-center">
          <i id="previewHeaderIcon" class="fa-solid fa-file text-primary fs-5 me-2"></i>
          <div>
            <h6 class="modal-title fw-bold text-dark text-truncate mb-0" id="previewModalLabel" style="max-width: 480px;">File Preview</h6>
            <div id="previewFileSize" class="text-muted" style="font-size: 0.75rem;">Size</div>
          </div>
        </div>
        <div class="d-flex align-items-center gap-2">
          <a href="#" id="previewDownloadBtn" class="btn btn-sm btn-outline-primary rounded-pill px-3">
            <i class="fa-solid fa-download me-1"></i>Download
          </a>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
      </div>
      <div class="modal-body p-0 bg-dark d-flex align-items-center justify-content-center" style="min-height: 480px; max-height: 80vh; overflow: hidden;">
        <div id="previewLoading" class="text-white text-center py-5">
          <div class="spinner-border text-light mb-2" role="status"></div>
          <div class="small">Loading secure preview from AWS S3...</div>
        </div>
        <div id="previewContent" class="w-100 h-100 d-none d-flex align-items-center justify-content-center">
          <!-- Dynamic Image or PDF Embed injected here -->
        </div>
      </div>
    </div>
  </div>
</div>

