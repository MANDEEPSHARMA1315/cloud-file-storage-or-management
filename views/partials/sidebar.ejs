<aside class="sidebar bg-white border-end d-flex flex-column" id="appSidebar">
  <!-- Brand Header -->
  <div class="sidebar-header p-3 border-bottom d-flex align-items-center justify-content-between">
    <a href="/dashboard" class="d-flex align-items-center text-decoration-none text-dark">
      <div class="brand-icon bg-primary text-white rounded-3 d-flex align-items-center justify-content-center me-2" style="width: 38px; height: 38px;">
        <i class="fa-solid fa-cloud fs-5"></i>
      </div>
      <div>
        <span class="fs-5 fw-bold text-primary">Cloud</span><span class="fs-5 fw-bold text-dark">Drive</span>
        <div class="text-muted" style="font-size: 0.68rem; line-height: 1;">
          <span class="badge bg-warning text-dark"><i class="fa-brands fa-aws me-1"></i>S3 Powered</span>
        </div>
      </div>
    </a>
    <button class="btn btn-sm btn-light d-md-none" id="sidebarCloseBtn">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>

  <!-- Quick Upload Button -->
  <div class="p-3">
    <div class="dropdown d-grid">
      <button class="btn btn-primary d-flex align-items-center justify-content-center py-2 shadow-sm rounded-pill fw-medium" type="button" data-bs-toggle="modal" data-bs-target="#uploadModal">
        <i class="fa-solid fa-plus me-2 fs-6"></i>
        <span>Upload Files</span>
      </button>
    </div>
  </div>

  <!-- Navigation Menu -->
  <div class="sidebar-menu flex-grow-1 overflow-auto px-2">
    <div class="text-uppercase text-muted fw-bold px-3 mb-2" style="font-size: 0.72rem; letter-spacing: 0.05rem;">Storage</div>
    <ul class="nav nav-pills flex-column mb-3">
      <li class="nav-item mb-1">
        <a href="/dashboard" class="nav-link <%= typeof path !== 'undefined' && path === '/dashboard' ? 'active' : 'text-dark' %> d-flex align-items-center py-2 px-3 rounded-3">
          <i class="fa-solid fa-chart-pie me-3 fs-6 <%= typeof path !== 'undefined' && path === '/dashboard' ? '' : 'text-primary' %>" style="width: 18px;"></i>
          <span>Dashboard</span>
        </a>
      </li>
      <li class="nav-item mb-1">
        <a href="/files" class="nav-link <%= typeof path !== 'undefined' && path === '/files' ? 'active' : 'text-dark' %> d-flex align-items-center py-2 px-3 rounded-3">
          <i class="fa-solid fa-folder-open me-3 fs-6 <%= typeof path !== 'undefined' && path === '/files' ? '' : 'text-warning' %>" style="width: 18px;"></i>
          <span>My Files</span>
        </a>
      </li>
      <li class="nav-item mb-1">
        <a href="/folders" class="nav-link <%= typeof path !== 'undefined' && path === '/folders' ? 'active' : 'text-dark' %> d-flex align-items-center py-2 px-3 rounded-3">
          <i class="fa-solid fa-folder-tree me-3 fs-6 <%= typeof path !== 'undefined' && path === '/folders' ? '' : 'text-info' %>" style="width: 18px;"></i>
          <span>My Folders</span>
        </a>
      </li>
      <li class="nav-item mb-1">
        <a href="/recent" class="nav-link <%= typeof path !== 'undefined' && path === '/recent' ? 'active' : 'text-dark' %> d-flex align-items-center py-2 px-3 rounded-3">
          <i class="fa-solid fa-clock-rotate-left me-3 fs-6 <%= typeof path !== 'undefined' && path === '/recent' ? '' : 'text-success' %>" style="width: 18px;"></i>
          <span>Recent Files</span>
        </a>
      </li>
      <li class="nav-item mb-1">
        <a href="/trash" class="nav-link <%= typeof path !== 'undefined' && path === '/trash' ? 'active' : 'text-dark' %> d-flex align-items-center py-2 px-3 rounded-3">
          <i class="fa-solid fa-trash-can me-3 fs-6 <%= typeof path !== 'undefined' && path === '/trash' ? '' : 'text-danger' %>" style="width: 18px;"></i>
          <span>Trash</span>
        </a>
      </li>
    </ul>

    <div class="text-uppercase text-muted fw-bold px-3 mb-2" style="font-size: 0.72rem; letter-spacing: 0.05rem;">Account</div>
    <ul class="nav nav-pills flex-column mb-3">
      <li class="nav-item mb-1">
        <a href="/profile" class="nav-link <%= typeof path !== 'undefined' && path === '/profile' ? 'active' : 'text-dark' %> d-flex align-items-center py-2 px-3 rounded-3">
          <i class="fa-solid fa-gear me-3 fs-6 <%= typeof path !== 'undefined' && path === '/profile' ? '' : 'text-secondary' %>" style="width: 18px;"></i>
          <span>Profile & Settings</span>
        </a>
      </li>
      <li class="nav-item mb-1">
        <a href="/logout" class="nav-link text-danger d-flex align-items-center py-2 px-3 rounded-3">
          <i class="fa-solid fa-arrow-right-from-bracket me-3 fs-6" style="width: 18px;"></i>
          <span>Sign Out</span>
        </a>
      </li>
    </ul>
  </div>

  <!-- Storage Quota Widget -->
  <div class="p-3 border-top bg-light">
    <% 
      const storage = typeof storageInfo !== 'undefined' && storageInfo ? storageInfo : {
        formattedUsed: '0 B',
        formattedQuota: '500 MB',
        percentage: 0,
        isNearQuota: false
      };
      let barColor = 'bg-primary';
      if (storage.percentage >= 90) {
        barColor = 'bg-danger';
      } else if (storage.percentage >= 80) {
        barColor = 'bg-warning';
      }
    %>
    <div class="d-flex align-items-center justify-content-between mb-1">
      <span class="small fw-semibold text-dark"><i class="fa-solid fa-hard-drive me-1 text-muted"></i> Storage</span>
      <span class="small text-muted fw-medium"><%= storage.percentage %>%</span>
    </div>
    <div class="progress" style="height: 7px;">
      <div class="progress-bar <%= barColor %>" role="progressbar" style="width: <%= storage.percentage %>%;" aria-valuenow="<%= storage.percentage %>" aria-valuemin="0" aria-valuemax="100"></div>
    </div>
    <div class="d-flex align-items-center justify-content-between mt-2">
      <div class="small text-muted" style="font-size: 0.75rem;">
        <%= storage.formattedUsed %> of <%= storage.formattedQuota %>
      </div>
      <a href="/profile" class="small text-decoration-none fw-semibold" style="font-size: 0.75rem;">Upgrade</a>
    </div>
  </div>
</aside>

