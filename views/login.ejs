<%- include('partials/header') %>

<div class="min-vh-100 d-flex flex-column justify-content-center bg-light py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5 col-xl-4">
        
        <!-- App Brand Logo -->
        <div class="text-center mb-4">
          <a href="/" class="d-inline-flex align-items-center text-decoration-none text-dark">
            <div class="brand-icon bg-primary text-white rounded-3 d-flex align-items-center justify-content-center me-2 shadow" style="width: 44px; height: 44px;">
              <i class="fa-solid fa-cloud fs-4"></i>
            </div>
            <span class="fs-3 fw-bold text-primary">Cloud</span><span class="fs-3 fw-bold text-dark">Drive</span>
          </a>
          <p class="text-muted small mt-1">Sign in to access your cloud files and folders</p>
        </div>

        <!-- Flash Messages -->
        <%- include('partials/toast') %>

        <!-- Database Connection Warning if not connected -->
        <% if (typeof isDbConnected !== 'undefined' && !isDbConnected) { %>
          <div class="alert alert-warning border-0 shadow-sm rounded-4 p-3 mb-4 d-flex align-items-start">
            <i class="fa-solid fa-triangle-exclamation text-warning fs-4 me-3 mt-1"></i>
            <div>
              <div class="fw-bold text-dark small">MongoDB Service Not Connected</div>
              <div class="text-muted" style="font-size: 0.8rem;">
                Local MongoDB is not running on <code>localhost:27017</code>. To sign in or register, start MongoDB locally or configure your MongoDB Atlas URI in <code>.env</code>.
              </div>
            </div>
          </div>
        <% } %>

        <!-- Login Card -->
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-4 bg-white">
          <h4 class="fw-bold text-dark mb-3">Sign In</h4>
          
          <form action="/login" method="POST" id="loginForm">
            <div class="mb-3">
              <label for="email" class="form-label small fw-semibold text-muted">Email Address</label>
              <div class="input-group">
                <span class="input-group-text bg-light text-muted border-end-0">
                  <i class="fa-solid fa-envelope"></i>
                </span>
                <input 
                  type="email" 
                  name="email" 
                  id="email" 
                  class="form-control border-start-0" 
                  placeholder="name@example.com" 
                  required 
                  autofocus
                >
              </div>
            </div>

            <div class="mb-3">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <label for="password" class="form-label small fw-semibold text-muted mb-0">Password</label>
              </div>
              <div class="input-group">
                <span class="input-group-text bg-light text-muted border-end-0">
                  <i class="fa-solid fa-lock"></i>
                </span>
                <input 
                  type="password" 
                  name="password" 
                  id="password" 
                  class="form-control border-start-0" 
                  placeholder="Enter your password" 
                  required
                >
              </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 rounded-pill fw-semibold shadow-sm mb-3">
              <i class="fa-solid fa-arrow-right-to-bracket me-2"></i>Sign In
            </button>
          </form>

          <div class="text-center mt-3 pt-3 border-top">
            <span class="text-muted small">Don't have an account?</span>
            <a href="/register" class="small fw-semibold text-decoration-none ms-1">Create an account</a>
          </div>
        </div>

        <!-- Tech Footer -->
        <div class="text-center text-muted small mt-4">
          <i class="fa-brands fa-aws me-1 text-warning"></i> Secured by AWS S3 &bull; Encrypted Storage
        </div>

      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

