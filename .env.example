# Application Configuration
PORT=3000
NODE_ENV=development
SESSION_SECRET=cloud_file_storage_super_secure_session_secret_key_2026

# Database Configuration
# For local MongoDB: mongodb://127.0.0.1:27017/cloud_storage
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/cloud_storage?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/cloud_storage

# Storage Provider: "s3" for AWS S3 or "local" for local disk fallback
STORAGE_PROVIDER=s3

# AWS S3 Configuration (Required when STORAGE_PROVIDER=s3)
AWS_REGION=us-east-1
AWS_BUCKET_NAME=my-cloud-storage-bucket-2026
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Default User Storage Quota in Bytes (Default: 500 MB = 524288000 bytes, 1 GB = 1073741824 bytes, 5 GB = 5368709120 bytes)
DEFAULT_STORAGE_QUOTA=524288000

# File Upload Configuration
MAX_FILE_SIZE_MB=50
PRESIGNED_URL_EXPIRES_IN=900

